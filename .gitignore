data/raw/*
data/processed/*
data/splits/*
data/alerts.db
# trained bundles are built by `make train`, never committed
models/*
# which bundle the API serves (scripts/promote.py): local state, like netwatch.db
models/ACTIVE
reports/*
__pycache__/
*.pyc
node_modules/
.next/

# Keep the directory skeleton: the patterns above would otherwise swallow the
# .gitkeep placeholders too, and a fresh clone would fail on the missing paths.
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/.gitkeep

# Local virtualenvs and editor state
.venv/
venv/
.vscode/
.idea/
.DS_Store
netwatch.db
.pytest_cache/
.env
.env*.local
*.env.local
.env*.production
*.env.production
dashboard/.env.local

# Deployment secrets and state: the production env file, TLS certificates and keys
# (scripts/init-ssl.sh), and backups (scripts/backup.sh)
deployment/.env.production
deployment/nginx/ssl/*
!deployment/nginx/ssl/.gitkeep
backups/
# Written on every run, never source: scripts/retrain.py's config copy and the
# TypeScript build cache
ml/config_retrain.yaml
dashboard/tsconfig.tsbuildinfo
