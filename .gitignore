# Keep the directory skeleton: the patterns above would otherwise swallow the
# .gitkeep placeholders too, and a fresh clone would fail on the missing paths.
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/.gitkeep

