{
  "uid": "netwatch-soc",
  "title": "NetWatch AI SOC — Production Telemetry",
  "tags": [
    "netwatch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Throughput & alerts",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Flows scored per second",
      "description": "POST /score, all callers.",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "rate(netwatch_flows_scored_total[1m])",
          "legendFormat": "flows/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Alert rate per 10k flows: live vs the evaluation report",
      "description": "Live counts every alert, attacks included, so it rises above the false-alert budget during an attack. On normal traffic it should sit near the report's figure.",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "10000 * rate(netwatch_flows_alerted_total[5m]) / rate(netwatch_flows_scored_total[5m])",
          "legendFormat": "live: flows that raised an alert"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "B",
          "expr": "netwatch_report_false_alerts_per_10k",
          "legendFormat": "report: false alerts on benign test flows"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "C",
          "expr": "netwatch_report_false_alert_budget_per_10k",
          "legendFormat": "budget"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "POST /score latency per request",
      "description": "One request is a batch of flows (the replayer sends 20).",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(netwatch_score_request_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(netwatch_score_request_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Alerts opened by family (per 5 minutes)",
      "description": "A burst of one family is one alert while it stays open (api/routes/score.py).",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "sum by (family) (increase(netwatch_alerts_opened_total[5m]))",
          "legendFormat": "{{family}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Triage & drift",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Drift status",
      "description": "The drift monitor's status: PSI and the unexplained-alert rate (docs/drift_strategy.md).",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "max(netwatch_drift_status{status=\"stable\"}) * 1 + max(netwatch_drift_status{status=\"warning\"}) * 2 + max(netwatch_drift_status{status=\"drift\"}) * 3",
          "legendFormat": "status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "warming up"
                },
                "1": {
                  "text": "stable"
                },
                "2": {
                  "text": "warning"
                },
                "3": {
                  "text": "drift"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Largest feature PSI",
      "description": "Warning at 0.10, drift at 0.25 on three or more features.",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 17,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "netwatch_drift_max_psi",
          "legendFormat": "max PSI"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Unexplained alert rate vs its training baseline",
      "description": "Drift is declared at 2x the baseline with PSI at Warning or above.",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 17,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "netwatch_drift_unexplained_alert_rate",
          "legendFormat": "now"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "B",
          "expr": "netwatch_drift_baseline_unexplained_alert_rate",
          "legendFormat": "baseline"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Alerts by triage status",
      "description": "Every alert in the store.",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "netwatch_alerts",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Analyst false-positive share",
      "description": "Recent alerts analysts marked false positive; their inputs train the next model.",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 23,
        "w": 7,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "netwatch_analyst_false_positive_share",
          "legendFormat": "share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Model being served",
      "description": "models/ACTIVE (scripts/promote.py).",
      "datasource": {
        "type": "prometheus",
        "uid": "netwatch-prometheus"
      },
      "gridPos": {
        "x": 17,
        "y": 23,
        "w": 7,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "netwatch-prometheus"
          },
          "refId": "A",
          "expr": "netwatch_model_info",
          "legendFormat": "{{version}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "name",
        "colorMode": "none"
      }
    }
  ]
}
