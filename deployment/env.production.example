# ==============================================================================
# NetWatch AI SOC — Production Environment Configuration
# ==============================================================================
# Copy to deployment/.env.production (gitignored) and edit. Every variable here
# is read by docker-compose.prod.yml or the deployment scripts; nothing else is
# configurable this way. Settings that live elsewhere:
#   false-alert budget, drift thresholds   ml/config.yaml (then retrain)
#   which model version is served         scripts/promote.py (models/ACTIVE)
#   API workers                           fixed at 1: its state is in-process
# ==============================================================================

# ── Where users open NetWatch ────────────────────────────────────────────────
# scheme://host[:port], with the port if NGINX_PORT / NGINX_SSL_PORT is not the
# default. The dashboard is built to call the API at <PUBLIC_URL>/api, so
# rebuild it after changing this. deploy.sh health-checks this URL too.
PUBLIC_URL=https://netwatch.yourdomain.com
# Health-check a different URL than PUBLIC_URL, e.g. when the domain does not
# resolve on the deploy host:
# HEALTHCHECK_URL=https://localhost

# ── Nginx ────────────────────────────────────────────────────────────────────
# http: plain HTTP on NGINX_PORT. https: HTTP redirects to TLS on NGINX_SSL_PORT,
# with the certificates scripts/init-ssl.sh writes to deployment/nginx/ssl.
# The redirect goes to the standard HTTPS port; with another NGINX_SSL_PORT,
# open https://<host>:<port> directly.
NGINX_SITE=https
NGINX_PORT=80
NGINX_SSL_PORT=443

# ── API ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from another origin. Behind
# nginx the dashboard is on the same origin, so it can stay empty (any origin,
# without credentials).
ALLOWED_ORIGINS=

# ── Demo replayer (docker compose ... --profile demo run --rm replayer) ──────
# normal | known | novel | drift | day | mixed (replay/replayer.py)
REPLAY_SCENARIO=mixed
REPLAY_RATE=40
REPLAY_LIMIT=5000

# ── Monitoring (docker-compose.monitoring.yml) ───────────────────────────────
# Grafana's admin password: required, there is no default.
GRAFANA_ADMIN_PASSWORD=change-this-grafana-secure-password
GRAFANA_PORT=3001
