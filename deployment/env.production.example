# ==============================================================================
# NetWatch AI SOC — Production Environment Configuration
# ==============================================================================
# Copy this file to .env.production and customize values before deployment.
# NEVER commit the active .env.production containing real secrets to version control.
# ==============================================================================

# ── General Environment ──────────────────────────────────────────────────────
ENVIRONMENT=production
NODE_ENV=production
LOG_LEVEL=info
DEBUG=false
TZ=UTC

# ── Security & Authentication ────────────────────────────────────────────────
# Generate a strong 64-character secret using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-key
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://netwatch.yourdomain.com,https://api.netwatch.yourdomain.com

# ── Public URLs ──────────────────────────────────────────────────────────────
# Public-facing URL for the Dashboard (used for SSR/redirects)
NEXT_PUBLIC_APP_URL=https://netwatch.yourdomain.com
# Public or proxy URL for the API backend
NEXT_PUBLIC_API_URL=https://api.netwatch.yourdomain.com
# WebSocket endpoint for real-time alert streaming
NEXT_PUBLIC_WS_URL=wss://api.netwatch.yourdomain.com/ws/alerts

# ── API Backend Service (FastAPI) ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Recommended workers: (2 * CPU cores) + 1
WEB_CONCURRENCY=4
UVICORN_TIMEOUT_KEEP_ALIVE=65
UVICORN_BACKLOG=2048

# ── Database & Persistence ───────────────────────────────────────────────────
# SQLite database path (mounted persistent volume)
NETWATCH_DB=/data/db/netwatch.db
# Model bundle directory path
MODEL_PATH=/data/models/v1
# Reports and metrics storage path
REPORTS_PATH=/data/reports

# ── Anomaly & Classification Engines ─────────────────────────────────────────
# Override budget for false alert rate per 10k flows (default: from metrics report)
ALERT_BUDGET_PER_10K=50
# Drift check schedule interval in minutes
DRIFT_CHECK_INTERVAL_MINUTES=60
# Retraining trigger threshold for population stability index (PSI) / KS test
DRIFT_PSI_THRESHOLD=0.25

# ── Nginx / Reverse Proxy ────────────────────────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443
DOMAIN_NAME=netwatch.yourdomain.com
SSL_CERT_PATH=/etc/nginx/ssl/live/netwatch.yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/live/netwatch.yourdomain.com/privkey.pem
# Rate limiting configuration
RATE_LIMIT_SCORE_RPS=100
RATE_LIMIT_BURST=50

# ── Monitoring & Observability ───────────────────────────────────────────────
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-this-grafana-secure-password
