# ==============================================================================
# NetWatch AI SOC — Production API Dockerfile (FastAPI + LightGBM + TreeSHAP)
# ==============================================================================
# Multi-stage hardened production container with non-root security context.
# ==============================================================================

# ── Stage 1: Build & Dependencies ─────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# No compiler: every requirement ships a wheel for Python 3.11 (the root
# Dockerfile, which CI builds, installs them without one). build-essential cost
# ~100 MB of downloads per build and was never used.
COPY requirements.txt .

# Install wheels into isolated directory
RUN pip install --no-cache-dir --user -r requirements.txt

# ── Stage 2: Hardened Production Runtime ──────────────────────────────────────
FROM python:3.11-slim AS runner

WORKDIR /app

# Install runtime OpenMP support and curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated non-root user and group
RUN groupadd -g 10001 netwatch && \
    useradd -u 10001 -g netwatch -s /bin/bash -m netwatch

# Copy installed python packages from builder
COPY --from=builder /root/.local /home/netwatch/.local

# Copy application source code
COPY --chown=netwatch:netwatch api /app/api
COPY --chown=netwatch:netwatch ml /app/ml
COPY --chown=netwatch:netwatch models /app/models
COPY --chown=netwatch:netwatch reports /app/reports
COPY --chown=netwatch:netwatch scripts /app/scripts
# GET /models serves the model card
COPY --chown=netwatch:netwatch docs/model_card.md /app/docs/model_card.md

# The alert store's volume (the root docker-compose.yml). models/ and reports/ are
# mounted from the host over the copies above.
RUN mkdir -p /data/db && \
    chown -R netwatch:netwatch /data /app

# Set environment paths and python configs
ENV PATH="/home/netwatch/.local/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app" \
    NETWATCH_DB="/data/db/netwatch.db"

USER netwatch

EXPOSE 8000

# Health check against root endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/ || exit 1

# One worker, on purpose. The API keeps state in the process: the loaded models,
# the drift window, alert grouping and the WebSocket connections. With 4 workers
# each had its own, so a dashboard only saw the alerts scored by the worker its
# socket happened to land on, and drift and grouping each saw a share of the
# traffic. Scale with a bigger container, not more workers.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-keep-alive", "65", "--access-log"]
